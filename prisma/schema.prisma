// Modelo de dominio do MVP. Depois de mexer aqui: npm run db:migrate
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// Atleta acompanhado pelo professor.
model Aluno {
  id             String    @id @default(uuid())
  nome           String
  dataNascimento DateTime?
  ativo          Boolean   @default(true)
  criadoEm       DateTime  @default(now())
  atualizadoEm   DateTime  @updatedAt

  avaliacoes Avaliacao[]
}

/// Uma sessao de avaliacao (uma linha da planilha antiga).
model Avaliacao {
  id            String   @id @default(uuid())
  alunoId       String
  dataAvaliacao DateTime
  observacoes   String?
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt

  aluno   Aluno    @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  medidas Medida[]
  testes  Teste[]

  @@index([alunoId, dataAvaliacao])
}

/// Medida antropometrica/funcional da avaliacao (CMJ, mobilidade de tornozelo...).
///
/// Uma tabela filha em vez de colunas fixas: na planilha isso eram ~16 colunas
/// lado a lado, e o professor acrescenta teste novo de tempos em tempos.
/// Medida bilateral usa `direito`/`esquerdo`; medida simples usa `valor`.
model Medida {
  id          String  @id @default(uuid())
  avaliacaoId String
  codigo      String
  unidade     String
  direito     Float?
  esquerdo    Float?
  valor       Float?

  avaliacao Avaliacao @relation(fields: [avaliacaoId], references: [id], onDelete: Cascade)

  @@unique([avaliacaoId, codigo])
}

/// Exercicio testado dentro da avaliacao (SALTO_AGACHADO, AGACHAMENTO...).
model Teste {
  id          String @id @default(uuid())
  avaliacaoId String
  codigo      String
  nome        String
  ordem       Int

  avaliacao  Avaliacao   @relation(fields: [avaliacaoId], references: [id], onDelete: Cascade)
  tentativas Tentativa[]

  @@unique([avaliacaoId, codigo])
  @@index([avaliacaoId])
}

/// Uma serie do teste: N repeticoes com uma carga, cronometradas.
/// A velocidade nao e armazenada — e derivada em src/lib/calculos.ts.
model Tentativa {
  id            String @id @default(uuid())
  testeId       String
  ordem         Int
  repeticoes    Int
  cargaValor    Float
  cargaUnidade  String
  tempoValor    Float
  tempoUnidade  String

  teste Teste @relation(fields: [testeId], references: [id], onDelete: Cascade)

  @@unique([testeId, ordem])
  @@index([testeId])
}
